    <script>
        lucide.createIcons();

        let pollingInterval = null;
        let qData = null;
        let isRefreshingToken = false;
        let pendingDeleteKey = null;

        const otpDigits = Array.from(document.querySelectorAll('.otp-digit'));

        function syncOtpValue() {
            document.getElementById('otp-input').value = otpDigits.map(input => input.value).join('');
        }

        function fillOtpDigits(value) {
            const digits = value.replace(/\D/g, '').slice(0, 4).split('');
            otpDigits.forEach((input, index) => {
                input.value = digits[index] || '';
            });
            syncOtpValue();
            if (digits.length === 4) document.getElementById('verify-btn').focus();
            else otpDigits[Math.min(digits.length, otpDigits.length - 1)]?.focus();
        }

        otpDigits.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                const value = e.target.value.replace(/\D/g, '');
                if (value.length > 1) {
                    fillOtpDigits(value);
                    return;
                }
                e.target.value = value;
                syncOtpValue();
                if (value && otpDigits[index + 1]) otpDigits[index + 1].focus();
            });
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !e.target.value && otpDigits[index - 1]) otpDigits[index - 1].focus();
            });
            input.addEventListener('paste', (e) => {
                e.preventDefault();
                fillOtpDigits(e.clipboardData.getData('text'));
            });
        });

        function goToStep(id) {
            document.querySelectorAll('.step-content').forEach(el => el.classList.remove('active'));
            document.getElementById('step-' + id).classList.add('active');
            document.getElementById('auth-indicator').classList.toggle('hidden', id !== 'dashboard');
        }

        function toggleConsole() {
            const el = document.getElementById('console-body');
            el.style.height = el.style.height === '260px' ? '0px' : '260px';
        }

        function clearLogs() {
            document.getElementById('console-logs').innerHTML = `<div class="text-emerald-900 italic">-- Logs cleared --</div>`;
        }

        function logAPI(method, url, body, status, data) {
            const logs = document.getElementById('console-logs');
            if(logs.innerHTML.includes('-- Listening')) logs.innerHTML = '';
            const logId = 'log-' + Math.random().toString(36).substr(2, 9);
            const time = new Date().toLocaleTimeString();
            const html = `
                <div class="border-l-2 border-emerald-900 pl-3 py-1 animate-fadeIn">
                    <div class="flex justify-between items-center opacity-60">
