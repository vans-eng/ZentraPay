            setDashboardLoader(false);
        }

        function renderSettingsPanel(static_qr) {
            const phone = localStorage.getItem('merchant_phone') || document.getElementById('phone-target')?.innerText || '';
            const html = `
                <div class="bg-white rounded-3xl border border-slate-100 overflow-hidden shadow-sm animate-fadeIn p-6 space-y-6">
                    <div class="flex items-center gap-3 border-b border-slate-50 pb-4 bg-gradient-to-r from-slate-50/50 to-emerald-50/50 -mx-6 px-6">
                        <div class="w-8 h-8 bg-slate-900 rounded-xl flex items-center justify-center">
                            <i data-lucide="settings" class="w-4 h-4 text-white"></i>
                        </div>
                        <div>
                            <h4 class="text-[9px] font-black text-slate-800 uppercase tracking-widest">Merchant Settings</h4>
                            <p class="text-[8px] text-slate-400 font-bold">Simpan QRIS Statis untuk otomatisasi API</p>
                        </div>
                    </div>
                    
                    <div class="space-y-4">
                        <div>
                            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block mb-1.5">Nomor Merchant</span>
                            <span class="text-xs font-bold text-slate-800 bg-slate-50 px-3 py-2 rounded-xl block w-fit">${phone}</span>
                        </div>

                        <div class="space-y-2">
                            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block">Upload / Scan QRIS Statis</span>
                            <div id="settings-drop-zone" onclick="document.getElementById('settings-qr-file').click()" class="relative group cursor-pointer border-2 border-dashed border-slate-200 bg-slate-50 rounded-xl p-6 transition-all hover:border-emerald-500 flex flex-col items-center justify-center gap-2">
                                <input type="file" id="settings-qr-file" class="hidden" accept="image/*" onchange="handleSettingsFileSelect(event)">
                                <div class="text-center py-2" id="settings-drop-zone-content">
                                    <i data-lucide="image-plus" class="w-6 h-6 text-slate-400 mx-auto mb-1 group-hover:text-emerald-500"></i>
                                    <p class="text-[9px] font-black text-slate-400 uppercase group-hover:text-emerald-600">Drop static QR here or Click</p>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block">Static QR String</span>
                            <textarea id="settings-qr-string" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-[10px] font-mono h-24 outline-none resize-none focus:border-emerald-500" placeholder="000201010212...">${static_qr}</textarea>
                        </div>

                        <button onclick="saveSettings()" id="save-settings-btn" class="w-full bg-emerald-600 text-white py-4 rounded-xl font-bold shadow-lg shadow-emerald-50 hover:bg-emerald-700 transition-all flex items-center justify-center gap-2">
                            <i data-lucide="save" class="w-4 h-4"></i>
                            <span>Simpan Pengaturan</span>
                        </button>
                    </div>
                </div>
            `;
            document.getElementById('dashboard-view').innerHTML = html;
            lucide.createIcons();

            // Set up drag and drop
            const drop = document.getElementById('settings-drop-zone');
            if (drop) {
                drop.ondragover = (e) => { e.preventDefault(); drop.classList.add('drop-zone--over'); };
                drop.ondragleave = () => drop.classList.remove('drop-zone--over');
                drop.ondrop = (e) => { e.preventDefault(); drop.classList.remove('drop-zone--over'); handleSettingsFileSelect(e); };
            }
        }

        function handleSettingsFileSelect(e) {
            const files = e.target.files || e.dataTransfer.files;
            if (!files[0]) return;
            const file = files[0];
            const reader = new FileReader();
            reader.onload = function(event) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement("canvas");
                    const ctx = canvas.getContext("2d");
                    canvas.width = img.width;
                    canvas.height = img.height;
                    ctx.drawImage(img, 0, 0);
                    const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                    const code = jsQR(imageData.data, imageData.width, imageData.height);
                    if (code) {
                        document.getElementById('settings-qr-string').value = code.data;
                        document.getElementById('settings-drop-zone-content').innerHTML = `
                            <i data-lucide="check-circle" class="w-6 h-6 text-emerald-500 mx-auto mb-1"></i>
                            <p class="text-[9px] font-black text-emerald-600 uppercase">QR Scanned Successfully</p>
                        `;
                        lucide.createIcons();
                    } else {
                        alert("Tidak dapat membaca QR dari gambar ini.");
                    }
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file);
        }

        async function saveSettings() {
            const static_qr = document.getElementById('settings-qr-string').value.trim();
            const merchant_phone = localStorage.getItem('merchant_phone') || document.getElementById('phone-target')?.innerText || '';
            if (!static_qr) return alert('Silakan isi QR string terlebih dahulu');
            if (!merchant_phone) return alert('Sesi login tidak valid. Silakan logout dan login ulang.');
            
            const btn = document.getElementById('save-settings-btn');
            btn.disabled = true;
            btn.innerHTML = '<span class="animate-spin rounded-full h-4 w-4 border-2 border-white/20 border-t-white"></span>';
            
            try {
                const res = await fetchJSON('/dashboard/settings/save-qr', 'POST', { merchant_phone, static_qr });
                if (res.success) {
                    alert('QRIS Statis berhasil disimpan!');
                    fetchSettings();
                } else {
                    alert(res.error || 'Gagal menyimpan pengaturan');
                }
            } catch (e) {
                alert('Network Error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="save" class="w-4 h-4"></i><span>Simpan Pengaturan</span>';
                lucide.createIcons();
            }
        }

        window.onload = async () => {
            const t = localStorage.getItem('access_token');
            const r = localStorage.getItem('refresh_token');
            const cachedPhone = localStorage.getItem('merchant_phone');
            if (cachedPhone) {
                document.getElementById('phone-target').innerText = cachedPhone;
                // Strip +62 prefix for the input display if needed
                document.getElementById('phone-input').value = cachedPhone.replace('+62', '');
            }
            if(t) {
                saveTokens(t, r);
                goToStep('dashboard');
                await validateCurrentSession();
            }
        }
    </script>
</body>
</html>
