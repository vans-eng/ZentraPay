                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-[9px] font-black text-emerald-700 uppercase tracking-widest">Connected</span>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-4xl mx-auto p-5 md:py-10">
        
        <div id="step-login" class="step-content active w-full max-w-md mx-auto pt-6">
            <div class="premium-card rounded-[2rem] p-8">
