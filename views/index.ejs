    <!-- Delete Confirmation Modal -->
    <div id="delete-modal" class="fixed inset-0 z-[110] hidden flex items-center justify-center p-5">
        <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeDeleteModal()"></div>
        <div class="relative bg-white rounded-[2rem] w-full max-w-xs p-7 shadow-2xl animate-slideUp text-center">
            <div class="w-12 h-12 bg-rose-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <i data-lucide="trash-2" class="w-6 h-6 text-rose-600"></i>
            </div>
            <h3 class="text-lg font-extrabold mb-2">Hapus API Key?</h3>
