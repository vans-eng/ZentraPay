                        <div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl focus-within:border-emerald-500 transition-all overflow-hidden">
                            <span class="pl-4 pr-2 text-slate-400 font-bold text-sm">+62</span>
                            <input type="number" id="phone-input" placeholder="83826724514" required class="w-full bg-transparent p-3.5 outline-none font-bold text-slate-700 text-sm">
                        </div>
                    </div>
                    <button type="submit" id="login-btn" class="w-full bg-slate-900 text-white py-4 rounded-xl font-bold hover:bg-emerald-600 transition-all flex items-center justify-center gap-2 group shadow-lg shadow-slate-100">
