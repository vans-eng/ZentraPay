            if (otp.length !== 4) return alert('OTP wajib 4 digit.');
            const btn = document.getElementById('verify-btn');
            btn.disabled = true;
            try {
                const res = await fetchJSON('/auth/verify', 'POST', { otp, otp_token });
                const pair = getTokenPair(res);
                if(res.success && pair.accessToken) {
                    saveTokens(pair.accessToken, pair.refreshToken);
                    // Save active phone to localStorage so it persists on page reload/session refresh
                    const verifiedPhone = document.getElementById('phone-target').innerText;
                    if (verifiedPhone) localStorage.setItem('merchant_phone', verifiedPhone);
                    setTokenStatus('Token aktif dan valid', 'valid');
