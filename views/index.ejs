                        <input type="text" inputmode="numeric" maxlength="1" class="otp-digit h-16 rounded-2xl border border-slate-200 bg-slate-50 text-center text-3xl font-black text-indigo-600 outline-none transition-all focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-50">
